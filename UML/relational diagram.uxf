    <panel_attributes>SubjectPrerequisite
--
id: int PK
subject_id: int FK Ref Subject(id)
prerequisite_subject_id: int FK Ref Subject(id) NULL
custom_text: text NULL
is_corequisite: bool[false]

UNIQUE(subject_id, prerequisite_subject_id)
ON DELETE CASCADE via both subject FKs
