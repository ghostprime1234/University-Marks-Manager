    <panel_attributes>UserCourse
--
id: int PK
user_id: UUID FK Ref auth.users(id) NOT NULL   CK1
course_id: int FK Ref Course(id) NOT NULL    CK1
is_default: bool[false]

UNIQUE(user_id, course_id)
ON DELETE CASCADE via user_id, course_id
bg=#e6f3ff</panel_attributes>
