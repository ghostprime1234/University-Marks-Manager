    <panel_attributes>Subject
--
id: int PK
subject_code: string                                            CK1
semester_id: int FK Ref Semester(id) NOT NULL       CK1
subject_name: string
total_mark: float[0.0]
credit_points: int[6]
sync_subject: bool[false]
has_exam: bool[true]

UNIQUE(subject_code, semester_id)
ON DELETE CASCADE via semester_id
bg=#e6f3ff</panel_attributes>
