    <panel_attributes>Semester
--
id: int PK
name: string                                                   CK1
year: int                                                           CK1
course_id: int FK Ref Course(id)                         CK1

UNIQUE(course_id, name, year)
ON DELETE CASCADE via course_id
bg=#e6f3ff</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>1485</x>
      <y>828</y>
      <w>396</w>
      <h>207</h>
    </coordinates>
    <panel_attributes>Assignment
--
id: int PK
assessment: string                                             CK1
subject_id: int FK Ref Subject(id) NOT NULL        CK1
weighted_mark: Optional[float]
unweighted_mark: Optional[float]
mark_weight: Optional[float]
grade_type: string[GradeType.NUMERIC]
is_exam: bool[false]

UNIQUE(assessment, subject_id)
ON DELETE CASCADE via subject_id
bg=#e6f3ff</panel_attributes>
    <additional_attributes/>
  </element>
