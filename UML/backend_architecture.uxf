    <panel_attributes>&lt;&lt;Presentation Layer - API&gt;&gt;
routers/auth_proxy.py
--
Reverse Proxy for Supabase GoTrue
--
+ router: APIRouter
--
ANY  /auth/v1/{path:path}
--
Pattern: API Gateway / Reverse Proxy
Forwards to internal GoTrue (http://auth:9999)
Bypasses browser CORS &amp; mixed-content
Uses: httpx.AsyncClient</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates>
      <x>64</x>
