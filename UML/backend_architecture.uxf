    <panel_attributes>&lt;&lt;Presentation Layer - API&gt;&gt;
routers/subjects.py
--
FastAPI router for subject endpoints
--
+ router: APIRouter
--
GET    /subjects/
POST   /subjects/
GET    /subjects/{code}/{sem}/{year}
PUT    /subjects/{code}/{sem}/{year}
DELETE /subjects/{code}/{sem}/{year}
--
Pattern: Controller (API Router)
Uses models directly with JOINs
Validates semester existence
Dependency injection: Depends(get_session)</panel_attributes>
