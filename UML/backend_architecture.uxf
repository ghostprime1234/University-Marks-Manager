    <panel_attributes>&lt;&lt;Core Service Layer&gt;&gt;
src/core/auth.py
--
Supabase Token Verification
--
+ verify_token(token: str) → dict
+ extract_user_id(payload: dict) → UUID
--
Dependencies:
- pyjwt[crypto] / cryptography
- SUPABASE_JWT_SECRET
--
Pattern: Security Service
Stateless JWT signature validation</panel_attributes>
